ENV=dev

KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8086
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SPARK_MASTER_UI_HOST_PORT=8080
SPARK_MASTER_HOST_PORT=7077
SPARK_WORKER_UI_HOST_PORT=8081
ES_HOST_PORT=9200
AIRFLOW_WEBSERVER_HOST_PORT=8085
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8084
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REDDIT=social.reddit.posts
KAFKA_TOPIC_FACEBOOK=social.facebook.posts
KAFKA_TOPIC_INSTAGRAM=social.instagram.posts
KAFKA_TOPIC_ENRICHED=social.enriched.posts
KAFKA_TOPIC_DLQ=social.dlq

SPARK_MASTER=local[*]
AIRFLOW_SPARK_MASTER=local[2]
SPARK_APP_NAME=SocialLambdaPipeline

MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=change-me-minio-user
S3_SECRET_KEY=change-me-minio-password
S3_BUCKET=social-lake
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
STORAGE_RAW_BASE=s3a://social-lake/data/raw
STORAGE_DISCARDED_BASE=s3a://social-lake/data/discarded
STORAGE_BATCH_VIEWS_BASE=s3a://social-lake/data/batch_views
STREAM_CHECKPOINT_BASE=s3a://social-lake/checkpoints/speed
EVENT_TIME_MIN=2026-01-01
EVENT_TIME_MAX=2026-04-30
BATCH_INPUT_PARTITIONS=2
BATCH_SHUFFLE_PARTITIONS=2

ES_HOST=http://localhost:9200
ES_BATCH_INDEX=social_batch_views
ES_REALTIME_INDEX=social_realtime_views
ES_BATCH_ALIAS=batch_current

API_ADMIN_TOKEN=change-me-api-admin-token
API_ALLOW_ENV_WRITES=false
API_CORS_ALLOW_ORIGINS=http://localhost:8084,http://127.0.0.1:8084
ENABLE_DEMO_FALLBACK=true
TRAIN_DATA_ROOTS=data
ML_ARTIFACT_ROOTS=ml,/tmp

POSTGRES_USER=change-me-airflow-db-user
POSTGRES_PASSWORD=change-me-airflow-db-password
POSTGRES_DB=airflow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://change-me-airflow-db-user:change-me-airflow-db-password@localhost:5432/airflow
AIRFLOW_ADMIN_USERNAME=change-me-admin-user
AIRFLOW_ADMIN_PASSWORD=change-me-admin-password
AIRFLOW_ADMIN_EMAIL=admin@example.com

CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9002
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=social
CLICKHOUSE_USER=social
CLICKHOUSE_PASSWORD=change-me-clickhouse-password

REPLAY_RATE_PER_SEC=20
REPLAY_DEDUPE=true
STREAM_TRIGGER_SECS=5
STREAM_STARTING_OFFSETS=earliest
SPEED_WRITE_BATCH_SIZE=500
REALTIME_WINDOW_HOURS=3000
NLP_MODEL_NAME=vinai/phobert-base
VIRALITY_RETRAIN_CRON=0 2 * * 1
SENTIMENT_RETRAIN_CRON=0 3 * * 1
SENTIMENT_MIN_WEIGHTED_F1=0.80
SENTIMENT_MIN_ACCURACY=0.60
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO
CONSUMER_FLUSH_SIZE=500
CONSUMER_FLUSH_INTERVAL=60
