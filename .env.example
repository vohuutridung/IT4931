ENV=dev

KAFKA_HOST_PORT=9092
KAFKA_UI_HOST_PORT=8080
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
SPARK_MASTER_UI_HOST_PORT=8081
SPARK_MASTER_HOST_PORT=7077
SPARK_WORKER_UI_HOST_PORT=8083
REDIS_HOST_PORT=6379
CASSANDRA_HOST_PORT=9042
ES_HOST_PORT=9200
KIBANA_HOST_PORT=5601
AIRFLOW_WEBSERVER_HOST_PORT=8082
API_HOST_PORT=8000
DASHBOARD_HOST_PORT=8084
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REDDIT=social.reddit.posts
KAFKA_TOPIC_FACEBOOK=social.facebook.posts
KAFKA_TOPIC_INSTAGRAM=social.instagram.posts
KAFKA_TOPIC_DLQ=social.dlq

SPARK_MASTER=local[*]
SPARK_APP_NAME=SocialLambdaPipeline

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=social-lake
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
STORAGE_RAW_BASE=s3a://social-lake/data/raw
STORAGE_BATCH_VIEWS_BASE=s3a://social-lake/data/batch_views

REDIS_HOST=localhost
REDIS_PORT=6379
CASSANDRA_HOSTS=localhost
CASSANDRA_KEYSPACE=social_lambda
CASSANDRA_ENRICHMENTS_TABLE=enrichments
CASSANDRA_ALERTS_TABLE=alerts

ES_HOST=http://localhost:9200
ES_BATCH_INDEX=social_batch_views
ES_REALTIME_INDEX=social_realtime_views
ES_BATCH_ALIAS=batch_current

CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9002
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_DATABASE=social_warehouse
CLICKHOUSE_USER=social
CLICKHOUSE_PASSWORD=social

REPLAY_RATE_PER_SEC=20
REPLAY_DEDUPE=true
STREAM_TRIGGER_SECS=5
STREAM_STARTING_OFFSETS=latest
SPEED_WRITE_BATCH_SIZE=500
REALTIME_WINDOW_HOURS=4
NLP_MODEL_NAME=distilbert-base-uncased-finetuned-sst-2-english
SLACK_WEBHOOK_URL=
LOG_LEVEL=INFO
CONSUMER_FLUSH_SIZE=500
CONSUMER_FLUSH_INTERVAL=30
