FROM apache/airflow:2.9.3-python3.11

ARG AIRFLOW_VERSION=2.9.3
ARG SPARK_VERSION=3.5.1
ARG HADOOP_AWS_VERSION=3.3.4
ARG AWS_SDK_BUNDLE_VERSION=1.12.262
# Hardcode URL thay vì dùng ${PYTHON_VERSION} — base image set ENV PYTHON_VERSION=3.11.9 override ARG
ARG AIRFLOW_CONSTRAINTS_URL=https://raw.githubusercontent.com/apache/airflow/constraints-2.9.3/constraints-3.11.txt

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       default-jre-headless \
       curl \
       procps \
    && rm -rf /var/lib/apt/lists/*

USER airflow

# Cài pyspark riêng — bỏ qua constraint file của base image (hash conflict với 3.5.1)
RUN pip install --no-cache-dir --constraint /dev/null "pyspark==${SPARK_VERSION}"

# Để constraint file tự chọn version provider tương thích
RUN pip install --no-cache-dir \
      "apache-airflow-providers-apache-spark" \
      --constraint "${AIRFLOW_CONSTRAINTS_URL}"

USER root

# Tìm path pyspark thực tế, tạo symlink tại /opt/pyspark (path cố định, không phụ thuộc Python version)
RUN REAL_SPARK=$(python3 -c "import pyspark, os; print(os.path.dirname(pyspark.__file__))") \
    && echo "pyspark found at: ${REAL_SPARK}" \
    && ln -sfn "${REAL_SPARK}" /opt/pyspark \
    && curl --fail --show-error --silent --location --retry 3 \
           -o "${REAL_SPARK}/jars/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
           "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
    && curl --fail --show-error --silent --location --retry 3 \
           -o "${REAL_SPARK}/jars/aws-java-sdk-bundle-${AWS_SDK_BUNDLE_VERSION}.jar" \
           "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_BUNDLE_VERSION}/aws-java-sdk-bundle-${AWS_SDK_BUNDLE_VERSION}.jar" \
    && chown -R airflow: "${REAL_SPARK}/jars"

ENV SPARK_HOME=/opt/pyspark
ENV PATH="/opt/pyspark/bin:${PATH}"

USER airflow
