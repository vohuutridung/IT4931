apiVersion: v1
kind: Secret
metadata:
  name: social-pipeline-secrets
  namespace: social-pipeline
type: Opaque
stringData:
  MINIO_ROOT_USER: "replace-me-minio-user"
  MINIO_ROOT_PASSWORD: "replace-me-minio-password"
  S3_ACCESS_KEY: "replace-me-minio-user"
  S3_SECRET_KEY: "replace-me-minio-password"
  CLICKHOUSE_PASSWORD: "replace-me-clickhouse-password"
  POSTGRES_USER: "replace-me-airflow-db-user"
  POSTGRES_PASSWORD: "replace-me-airflow-db-password"
  POSTGRES_DB: "airflow"
  AIRFLOW__DATABASE__SQL_ALCHEMY_CONN: "postgresql+psycopg2://replace-me-airflow-db-user:replace-me-airflow-db-password@postgres-service/airflow"
  AIRFLOW_ADMIN_USERNAME: "replace-me-admin-user"
  AIRFLOW_ADMIN_PASSWORD: "replace-me-admin-password"
  AIRFLOW_ADMIN_EMAIL: "admin@example.com"
  API_ADMIN_TOKEN: "replace-me-api-admin-token"
