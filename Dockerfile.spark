FROM apache/spark:3.5.3

USER root

ARG SPARK_VERSION=3.5.3
ARG SCALA_BINARY_VERSION=2.12
# [FIX] kafka-clients 3.6.0 để khớp với Confluent 7.6.0 (Kafka 3.6.x)
ARG KAFKA_CLIENTS_VERSION=3.6.0
ARG HADOOP_AWS_VERSION=3.3.4
ARG AWS_SDK_BUNDLE_VERSION=1.12.262
ARG COMMONS_POOL2_VERSION=2.11.1
ARG SPARK_JARS_DIR=/opt/spark/jars

# ── Cài Python 3 + pip (apache/spark base không có sẵn pip) ───────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev curl \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && rm -rf /var/lib/apt/lists/*

# ── Python deps cho Spark jobs ────────────────────────────────────────────────
ENV PIP_BREAK_SYSTEM_PACKAGES=1

WORKDIR /app
COPY requirements.spark.txt .
RUN pip3 install --no-cache-dir -r requirements.spark.txt

# ── Tải JARs vào thư mục jars của Spark ──────────────────────────────────────
RUN curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/spark-sql-kafka-0-10_${SCALA_BINARY_VERSION}-${SPARK_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/spark/spark-sql-kafka-0-10_${SCALA_BINARY_VERSION}/${SPARK_VERSION}/spark-sql-kafka-0-10_${SCALA_BINARY_VERSION}-${SPARK_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/spark-token-provider-kafka-0-10_${SCALA_BINARY_VERSION}-${SPARK_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/spark/spark-token-provider-kafka-0-10_${SCALA_BINARY_VERSION}/${SPARK_VERSION}/spark-token-provider-kafka-0-10_${SCALA_BINARY_VERSION}-${SPARK_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/kafka-clients-${KAFKA_CLIENTS_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/kafka/kafka-clients/${KAFKA_CLIENTS_VERSION}/kafka-clients-${KAFKA_CLIENTS_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/hadoop-client-api-${HADOOP_AWS_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-client-api/${HADOOP_AWS_VERSION}/hadoop-client-api-${HADOOP_AWS_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/hadoop-client-runtime-${HADOOP_AWS_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-client-runtime/${HADOOP_AWS_VERSION}/hadoop-client-runtime-${HADOOP_AWS_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_AWS_VERSION}/hadoop-aws-${HADOOP_AWS_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/aws-java-sdk-bundle-${AWS_SDK_BUNDLE_VERSION}.jar" \
        "https://repo1.maven.org/maven2/com/amazonaws/aws-java-sdk-bundle/${AWS_SDK_BUNDLE_VERSION}/aws-java-sdk-bundle-${AWS_SDK_BUNDLE_VERSION}.jar" && \
    curl --fail --show-error --silent --location --retry 3 \
        -o "${SPARK_JARS_DIR}/commons-pool2-${COMMONS_POOL2_VERSION}.jar" \
        "https://repo1.maven.org/maven2/org/apache/commons/commons-pool2/${COMMONS_POOL2_VERSION}/commons-pool2-${COMMONS_POOL2_VERSION}.jar"

# ── Tạo thư mục Ivy cache ─────────────────────────────────────────────────────
RUN mkdir -p /home/spark/.ivy2/cache && chown -R spark:spark /home/spark/.ivy2

# ── App code ──────────────────────────────────────────────────────────────────
COPY speed/      speed/
COPY batch/      batch/
COPY config/     config/
COPY serving/    serving/
COPY scripts/    scripts/
COPY warehouse/  warehouse/
RUN touch __init__.py

# ── Runtime writable directories ──────────────────────────────────────────────
# [FIX] chmod 755 thay vì 777 — chỉ spark user cần ghi
RUN mkdir -p /tmp/social-speed/checkpoints /tmp/social-speed/bad_records \
    && chown -R spark:spark /tmp/social-speed \
    && chmod -R 755 /tmp/social-speed

# Fix permission cho thư mục work của Spark Worker
RUN mkdir -p /opt/spark/work && chown -R spark:spark /opt/spark/work

ENV SPARK_HOME=/opt/spark
ENV PYSPARK_PYTHON=python3
ENV PYTHONPATH=/app:/opt/spark/python:/opt/spark/python/lib/pyspark.zip
ENV PYTHONUNBUFFERED=1

USER spark